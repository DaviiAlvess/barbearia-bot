# Chave do Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=coloque_sua_chave_aqui
# Modelo do Gemini (se der erro de modelo, troque por outro da lista do AI Studio)
# Preferir 3.5-flash-lite (cota free separada). 2.5-flash free = ~20 req/dia.
GEMINI_MODEL=gemini-3.5-flash-lite

# WhatsApp do dono (só números, com 55 + DDD). É o número CADASTRADO:
# #agenda, alertas e comandos # usam este — também editável no painel → Salão.
TELEFONE_DONO=557581829675

# Senha do painel web (usuário: dono)
PAINEL_SENHA=troque_esta_senha
# Porta do painel na VPS (troque se já estiver em uso por outro projeto)
PAINEL_PORTA=8080

# Nível de log: DEBUG, INFO, WARNING
LOG_LEVEL=INFO

# Evolution API (WhatsApp via Baileys) — https://docs.evolutionfoundation.com.br/evolution-api
# Gere uma chave longa e aleatória; a mesma vai no header apikey da API.
EVOLUTION_API_KEY=troque_por_uma_chave_longa
EVOLUTION_INSTANCE=barbearia
# Senha do Postgres interno do compose (só rede Docker; não publica porta)
EVOLUTION_DB_PASSWORD=evolution_local
# Em Docker Compose estes dois são sobrescritos; localmente:
EVOLUTION_URL=http://localhost:8080
EVOLUTION_WEBHOOK_URL=http://localhost:8000/webhook

# WhatsApp Cloud API (Meta) - só precisa para rodar o whatsapp.py (caminho alternativo)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=escolha_uma_senha
