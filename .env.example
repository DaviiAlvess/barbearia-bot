# Chave do Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=coloque_sua_chave_aqui
# Modelo do Gemini (se der erro de modelo, troque por outro da lista do AI Studio)
GEMINI_MODEL=gemini-3.5-flash

# Seu WhatsApp (só números, com 55 + DDD). Recebe alertas e pode usar os comandos #agenda etc.
TELEFONE_DONO=5575900000000

# Senha do painel web (usuário: dono)
PAINEL_SENHA=troque_esta_senha
# Porta do painel na VPS (troque se já estiver em uso por outro projeto)
PAINEL_PORTA=8080

# Nível de log: DEBUG, INFO, WARNING
LOG_LEVEL=INFO

# WhatsApp pelo QR code (bot_whatsapp.py + servidor-whatsapp)
SERVIDOR_WHATSAPP=http://localhost:3000
ID_SESSAO=8113

# WhatsApp Cloud API (Meta) - só precisa para rodar o whatsapp.py
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=escolha_uma_senha
